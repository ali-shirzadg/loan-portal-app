# Copy to .env and change the passwords. .env is git-ignored.
# One file is shared by docker-compose and the API.

# --- API ---
NODE_ENV=development
PORT=3000

# --- Database (API + docker-compose) ---
DATABASE_HOST=127.0.0.1
DATABASE_PORT=3306
DATABASE_NAME=loan_portal
DATABASE_USERNAME=loan_app
DATABASE_PASSWORD=change-me

# --- Docker only: MySQL root password. The API never uses root. ---
DATABASE_ROOT_PASSWORD=change-me-root
