# Copy to .env and change the passwords. .env is git-ignored.
# One file is shared by docker-compose and the API.

# --- API ---
NODE_ENV=development
PORT=3000

# --- Database (API + docker-compose) ---
DATABASE_HOST=127.0.0.1
DATABASE_PORT=3306
DATABASE_NAME=loan_portal
DATABASE_USERNAME=loan_app
DATABASE_PASSWORD=change-me

# --- Docker only: MySQL root password. The API never uses root. ---
DATABASE_ROOT_PASSWORD=change-me-root

# --- Redis (BullMQ queue; API + docker-compose) ---
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=change-me-redis

# --- Auth ---
# At least 32 characters. Generate with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string-of-32-chars-or-more
JWT_EXPIRES_IN_SECONDS=3600
# Encrypts NRIC, phone and income in the database. Generate: openssl rand -base64 32
# Losing or changing it makes existing applications unreadable.
FIELD_ENCRYPTION_KEY=
# Set to true behind HTTPS (production). Must be false for plain http://localhost.
COOKIE_SECURE=false

# --- Web ---
# Origin allowed by CORS (and used for cookies).
WEB_ORIGIN=http://localhost:4200
